<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Minha senha | CHARTH</title>
<link rel="stylesheet" href="/public/shared/css/base.css"><link rel="stylesheet" href="/public/admin/css/admin.css"></head>
<body><%- include('panel-header') %>
<main class="admin-main"><section class="card"><div class="card-header"><h2><%= panelUser.must_change_password ? 'Defina sua senha para continuar' : 'Alterar minha senha' %></h2></div><div class="card-body">
    <p>Escolha uma senha de pelo menos 12 caracteres.</p>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form method="POST" action="/admin/account/password">
        <input type="hidden" name="_csrf" value="<%= panelCsrf %>">
        <div class="form-group"><label for="current-password">Senha atual ou inicial</label><input class="form-control" id="current-password" name="current_password" type="password" required autocomplete="current-password"></div>
        <div class="form-group"><label for="new-password">Nova senha</label><input class="form-control" id="new-password" name="password" type="password" required minlength="12" maxlength="72" autocomplete="new-password"></div>
        <div class="form-group"><label for="confirm-password">Confirme a nova senha</label><input class="form-control" id="confirm-password" name="confirm_password" type="password" required minlength="12" maxlength="72" autocomplete="new-password"></div>
        <button type="submit" class="btn btn-primary">Salvar minha senha</button>
    </form>
</div></section></main></body></html>
